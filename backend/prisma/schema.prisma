generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  HOSPITAL_ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  LAB_ADMIN
  PATIENT
}

enum BusinessType {
  HOSPITAL
  LABORATORY
}

enum BookingStatus {
  PENDING
  WAITING
  IN_CONSULTATION
  COMPLETED
  CANCELLED
}

model Hospital {
  id                 String       @id @default(uuid())
  name               String
  businessType       BusinessType
  facilityType       String?
  registrationNumber String?
  establishedYear    String?
  logoUrl            String?

  // Contact
  contactPhone     String?
  contactEmail     String?
  website          String?
  emergencyContact String?

  // Location
  addressLine1 String?
  addressLine2 String?
  area         String?
  city         String?
  state        String?
  country      String?
  pincode      String?

  // Services as a JSON array of strings
  services String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  departments     Department[]
  verifications   HospitalVerification[]
  rolePermissions RolePermission[]
  opBookings      OPBooking[]
  doctorSchedules DoctorSchedule[]
}

model PlatformSpecialty {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  conditions  PlatformCondition[]
  departments Department[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformCondition {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  specialtyId String
  specialty   PlatformSpecialty @relation(fields: [specialtyId], references: [id])

  opBookings  OPBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HospitalVerification {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  documentType String // e.g., 'REGISTRATION', 'CLINICAL_ESTABLISHMENT', 'NABH'
  fileUrl      String // Path or URL to the uploaded file

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  phone        String? @unique
  passwordHash String
  name         String
  role         Role
  designation  String?
  avatar       String?
  dob          String?
  gender       String?
  active       Boolean @default(true)

  // Nullable because SUPER_ADMIN might not belong to one hospital
  hospitalId String?
  hospital   Hospital? @relation(fields: [hospitalId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  doctorBookings  OPBooking[] @relation("DoctorBookings")
  patientBookings OPBooking[] @relation("PatientBookings")
  labBookings     LabBooking[]
  nursingBookings HomeNursingBooking[]
  patientReports  PatientReport[]
  doctorSchedules DoctorSchedule[] @relation("DoctorSchedule")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  name        String
  code        String?
  description String?

  specialtyId String
  specialty   PlatformSpecialty @relation(fields: [specialtyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  opBookings OPBooking[]

  @@unique([hospitalId, name])
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  name        String
  description String?
  module      String

  createdAt DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  role       Role

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  enabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, role, permissionId])
}

model OPBooking {
  id              String        @id @default(uuid())
  hospitalId      String
  hospital        Hospital      @relation(fields: [hospitalId], references: [id])
  departmentId    String
  department      Department    @relation(fields: [departmentId], references: [id])
  doctorId        String
  doctor          User          @relation("DoctorBookings", fields: [doctorId], references: [id])
  patientId       String?
  patient         User?         @relation("PatientBookings", fields: [patientId], references: [id])
  conditionId     String?
  condition       PlatformCondition? @relation(fields: [conditionId], references: [id])
  timeSlot        String?
  slotTime        String?
  reason          String?
  
  patientName     String
  patientPhone    String?
  patientAge      Int?
  patientGender   String?
  opType          String        @default("Normal")
  
  status          BookingStatus @default(WAITING)
  appointmentDate DateTime      @default(now())
  fee             Float         @default(0)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model LabTest {
  id              String   @id @default(uuid())
  name            String
  category        String
  sampleType      String?
  description     String?
  preparation     String?
  turnaroundTime  String?
  parametersCount Int?     @default(1)
  price           Float
  iconUrl         String?
  healthConcern   String?
  active          Boolean  @default(true)

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  offerings       LaboratoryTestOffering[]
  bookings        LabBooking[]
}

model LaboratoryTestOffering {
  id                      String   @id @default(uuid())
  laboratoryId            String
  testId                  String
  test                    LabTest  @relation(fields: [testId], references: [id], onDelete: Cascade)
  price                   Float
  homeCollectionAvailable Boolean  @default(true)
  homeCollectionFee       Float    @default(0)
  active                  Boolean  @default(true)

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([laboratoryId, testId])
}

model LabBooking {
  id                String   @id @default(uuid())
  bookingNumber     String   @unique
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId        String?
  laboratoryId      String
  testId            String
  test              LabTest  @relation(fields: [testId], references: [id])

  patientName       String
  patientAge        Int?
  patientGender     String?
  patientPhone      String
  patientEmail      String?

  bookingDate       DateTime
  timeSlot          String
  collectionType    String   @default("LAB_VISIT") // 'LAB_VISIT' | 'HOME_COLLECTION'
  collectionAddress String?

  status            String   @default("CONFIRMED") // 'CONFIRMED', 'SAMPLE_COLLECTED', 'PROCESSING', 'COMPLETED', 'CANCELLED'
  paymentStatus     String   @default("PAID")      // 'PENDING', 'PAID', 'REFUNDED'
  testPrice         Float
  collectionFee     Float    @default(0)
  totalAmount       Float
  notes             String?

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model NursingService {
  id           String   @id @default(uuid())
  name         String   @unique
  code         String   @unique
  category     String
  description  String?
  duration     String   @default("12 / 24 Hours")
  basePrice    Float
  requirements String?
  iconUrl      String?
  active       Boolean  @default(true)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  offerings    NursingServiceOffering[]
  bookings     HomeNursingBooking[]

  @@map("nursing_services")
}

model NursingServiceOffering {
  id          String         @id @default(uuid())
  hospitalId  String
  serviceId   String
  service     NursingService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  price       Float
  duration    String?
  available   Boolean        @default(true)
  serviceArea String?

  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@unique([hospitalId, serviceId])
  @@map("nursing_service_offerings")
}

model HomeNursingBooking {
  id            String         @id @default(uuid())
  bookingNumber String         @unique
  userId        String
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  hospitalId    String
  serviceId     String
  service       NursingService @relation(fields: [serviceId], references: [id])
  nurseId       String?

  patientName   String
  patientPhone  String
  patientEmail  String?
  patientAge    Int?
  patientGender String?

  serviceDate   DateTime
  timeSlot      String
  duration      String?
  address       String
  city          String?
  pincode       String?
  notes         String?

  status        String         @default("CONFIRMED") // 'CONFIRMED', 'ASSIGNED', 'IN_PROGRESS', 'COMPLETED', 'CANCELLED'
  paymentStatus String         @default("PAID")      // 'PENDING', 'PAID', 'REFUNDED'
  paymentMethod String?                              // 'CARD', 'UPI', etc.
  totalAmount   Float

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([hospitalId, serviceDate, timeSlot, nurseId, userId])
  @@map("home_nursing_bookings")
}

model PatientReport {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  title       String
  hospital    String
  doctor      String?
  date        String
  pages       String   @default("1 page")
  status      String   @default("Normal")
  statusColor String?  @default("text-emerald-600 bg-emerald-100/60")
  iconName    String?  @default("FileText")
  iconColor   String?  @default("text-blue-500")
  bg          String?  @default("bg-blue-50")
  summary     String?
  
  fileUrl     String
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("patient_reports")
}

model DoctorSchedule {
  id                  String   @id @default(uuid())
  doctorId            String
  doctor              User     @relation("DoctorSchedule", fields: [doctorId], references: [id], onDelete: Cascade)
  hospitalId          String
  hospital            Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  dayOfWeek           String   // e.g. "Monday", "Tuesday", etc.
  startTime           String   @default("09:00")
  endTime             String   @default("13:00")
  videoStartTime      String?  @default("14:00")
  videoEndTime        String?  @default("18:00")
  slotDurationMinutes Int      @default(15)
  isAvailable         Boolean  @default(true)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([doctorId, dayOfWeek])
  @@map("doctor_schedules")
}


