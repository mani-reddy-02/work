generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  SUPER_ADMIN
  HOSPITAL_ADMIN
  DOCTOR
  NURSE
  RECEPTIONIST
  LAB_ADMIN
  PATIENT
}

enum BusinessType {
  HOSPITAL
  LABORATORY
}

enum BookingStatus {
  PENDING
  WAITING
  IN_CONSULTATION
  COMPLETED
  CANCELLED
}

model Hospital {
  id                 String       @id @default(uuid())
  name               String
  businessType       BusinessType
  facilityType       String?
  registrationNumber String?
  establishedYear    String?
  logoUrl            String?

  // Contact
  contactPhone     String?
  contactEmail     String?
  website          String?
  emergencyContact String?

  // Location
  addressLine1 String?
  addressLine2 String?
  area         String?
  city         String?
  state        String?
  country      String?
  pincode      String?

  // Services as a JSON array of strings
  services String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users           User[]
  departments     Department[]
  verifications   HospitalVerification[]
  rolePermissions RolePermission[]
  opBookings      OPBooking[]
}

model PlatformSpecialty {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  conditions  PlatformCondition[]
  departments Department[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlatformCondition {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  specialtyId String
  specialty   PlatformSpecialty @relation(fields: [specialtyId], references: [id])

  opBookings  OPBooking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HospitalVerification {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  documentType String // e.g., 'REGISTRATION', 'CLINICAL_ESTABLISHMENT', 'NABH'
  fileUrl      String // Path or URL to the uploaded file

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  phone        String? @unique
  passwordHash String
  name         String
  role         Role
  designation  String?
  avatar       String?
  dob          String?
  gender       String?
  active       Boolean @default(true)

  // Nullable because SUPER_ADMIN might not belong to one hospital
  hospitalId String?
  hospital   Hospital? @relation(fields: [hospitalId], references: [id])

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  doctorBookings  OPBooking[] @relation("DoctorBookings")
  patientBookings OPBooking[] @relation("PatientBookings")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])

  name        String
  code        String?
  description String?

  specialtyId String
  specialty   PlatformSpecialty @relation(fields: [specialtyId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  opBookings OPBooking[]

  @@unique([hospitalId, name])
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  name        String
  description String?
  module      String

  createdAt DateTime @default(now())

  rolePermissions RolePermission[]
}

model RolePermission {
  id         String   @id @default(uuid())
  hospitalId String
  hospital   Hospital @relation(fields: [hospitalId], references: [id])
  role       Role

  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id])

  enabled Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([hospitalId, role, permissionId])
}

model OPBooking {
  id              String        @id @default(uuid())
  hospitalId      String
  hospital        Hospital      @relation(fields: [hospitalId], references: [id])
  departmentId    String
  department      Department    @relation(fields: [departmentId], references: [id])
  doctorId        String
  doctor          User          @relation("DoctorBookings", fields: [doctorId], references: [id])
  patientId       String?
  patient         User?         @relation("PatientBookings", fields: [patientId], references: [id])
  conditionId     String?
  condition       PlatformCondition? @relation(fields: [conditionId], references: [id])
  timeSlot        String?
  reason          String?
  
  patientName     String
  patientPhone    String?
  patientAge      Int?
  patientGender   String?
  opType          String        @default("Normal")
  
  status          BookingStatus @default(WAITING)
  appointmentDate DateTime      @default(now())
  fee             Float         @default(0)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}
