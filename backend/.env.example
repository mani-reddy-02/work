# Database (Supabase Direct Connection - Port 5432)
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Application
PORT=5000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"

# Authentication
JWT_SECRET="replace_with_your_super_secret_key"
JWT_EXPIRES_IN="7d"

# Meta WhatsApp Business Cloud API (Official Provider)
# Obtain these from https://developers.facebook.com/apps -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN="your_meta_system_user_or_temporary_access_token"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_whatsapp_business_account_id"
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your_custom_webhook_secret_verify_token"

# Google Gemini API (For Health Education Assistant)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY="your_gemini_api_key_here"
