# Database (Supabase Direct Connection - Port 5432)
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Application
PORT=5000
NODE_ENV="development"
CORS_ORIGIN="http://localhost:5173"

# Authentication
JWT_SECRET="replace_with_your_super_secret_key"
JWT_EXPIRES_IN="7d"

# Meta WhatsApp Business Cloud API (Official Provider)
# Obtain these from https://developers.facebook.com/apps -> WhatsApp -> API Setup
WHATSAPP_ACCESS_TOKEN="your_meta_system_user_or_temporary_access_token"
WHATSAPP_PHONE_NUMBER_ID="your_whatsapp_phone_number_id"
WHATSAPP_BUSINESS_ACCOUNT_ID="your_whatsapp_business_account_id"
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="your_custom_webhook_secret_verify_token"

# Google Gemini & Google Cloud (Primary AI Provider)
# How to set up with Google Cloud Billing (Pay-As-You-Go with your Credit Card):
# 1. Open Google Cloud Console: https://console.cloud.google.com/
# 2. Select or create your GCP project and ensure Billing is linked: https://console.cloud.google.com/billing
# 3. Enable the "Generative Language API" in GCP Console -> APIs & Services -> Library
# 4. Generate an API Key under APIs & Services -> Credentials -> Create Credentials -> API Key
#    (Or in Google AI Studio linked to your Google Cloud billing project: https://aistudio.google.com/app/apikey)
# 5. Overuse will automatically be charged to your Google Cloud credit card with no rate limit blocking.
GEMINI_API_KEY="AIzaSy..."
GEMINI_MODEL="gemini-3.8-flash"

# Alternative Providers (Optional fallbacks)
# GROQ_API_KEY="gsk_..."
# OPENROUTER_API_KEY="sk-or-..."

# LiveKit Cloud (Two-Way Video Consultations)
LIVEKIT_URL="wss://your-project.livekit.cloud"
LIVEKIT_API_KEY="your_livekit_api_key"
LIVEKIT_API_SECRET="your_livekit_api_secret"